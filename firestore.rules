rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role helper: check user document in /users/{userId}
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManager() {
      return isAuthenticated() && (
        request.auth.token.role == 'manager' ||
        getUserData().role == 'manager'
      );
    }

    function isAssignedMember(memberId) {
      return isAuthenticated() && (
        request.auth.uid == memberId ||
        getUserData().id == memberId
      );
    }

    // Users collection:
    // - Managers can read/write all user profiles
    // - Team members can read their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManager());
      allow write: if isManager();
    }

    // Customers / Payment Collections collection:
    // RBAC Rules:
    // 1. Manager has full READ and WRITE privileges across all customer records.
    // 2. Team Members can ONLY READ customer records assigned to them (assignedMemberId == auth.uid).
    // 3. Team Members can CREATE customer records if they set assignedMemberId to their own uid.
    // 4. Team Members can UPDATE customer records assigned to them (updating payment status, received amount, remarks).
    // 5. Team Members CANNOT delete customer records (only Managers can delete).
    match /customers/{customerId} {
      allow read: if isManager() || (isAuthenticated() && resource.data.assignedMemberId == request.auth.uid);
      
      allow create: if isAuthenticated() && (
        isManager() || 
        (request.resource.data.assignedMemberId == request.auth.uid)
      );

      allow update: if isAuthenticated() && (
        isManager() || 
        (resource.data.assignedMemberId == request.auth.uid && request.resource.data.assignedMemberId == request.auth.uid)
      );

      allow delete: if isManager();
    }
  }
}
